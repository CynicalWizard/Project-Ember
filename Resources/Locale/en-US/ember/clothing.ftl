# Uniforms ported from SierraBay12 can be worn three ways: ordinary, sleeves up, or pulled down
# to the waist. The two verbs move between them.
ember-clothing-roll-sleeves-verb = Roll up sleeves
ember-clothing-unroll-sleeves-verb = Roll down sleeves
ember-clothing-pull-down-verb = Pull down
ember-clothing-pull-up-verb = Pull up
ember-clothing-roll-sleeves-blocked = You would have to pull the {$item} up first.
