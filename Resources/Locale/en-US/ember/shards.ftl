# Debris takes its name from the material it broke off. Both the plain and the declined form of that name are
# passed in, because the languages need different ones; English uses the plain one.
ember-shard-name-shard = { $material } shard
ember-shard-name-shrapnel = { $material } shrapnel
ember-shard-name-piece = { $material } piece
ember-shard-name-splinters = { $material } splinters

ember-shard-desc-shard = A small piece of { $material }. It looks sharp; you would not want to step on it barefoot.
ember-shard-desc-shrapnel = A twisted sliver of { $material }, torn off something that gave way.
ember-shard-desc-piece = A broken piece of { $material }, edges still rough.
ember-shard-desc-splinters = Splinters of { $material }. Small, sharp, and impossible to see until you tread on them.

ember-assemble-grille-occupied = There is already a grille here.
ember-assemble-grille-not-enough = You need at least two rods for that.
